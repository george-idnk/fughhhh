# ─────────────────────────────────────────────────────────────
# Eilabun Melkite Catholic Archive — environment configuration
# Copy to `.env` and fill in the values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Database. SQLite for development (path is relative to prisma/schema.prisma).
# For PostgreSQL in production see README → "Deploying".
DATABASE_URL="file:./dev.db"

# Secret used to sign admin session cookies. REQUIRED.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# YouTube Data API v3 key (optional). Enables automatic discovery on /admin/discover
# and richer metadata when adding YouTube links. Without it, the archive still works
# with manually added recordings.
YOUTUBE_API_KEY=

# Public base URL of the site (used for canonical links / metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default interface language: ar | en | he
DEFAULT_LOCALE=ar

# Where authorized original/enhanced audio files are stored (outside /public).
STORAGE_DIR=./storage

# Maximum upload size for authorized audio, in megabytes.
MAX_UPLOAD_MB=300

# Path to ffmpeg (used only by the optional audio-enhancement pipeline).
FFMPEG_PATH=ffmpeg

# Optional: create the first admin non-interactively with `npm run admin:create`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
